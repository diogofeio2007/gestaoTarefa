<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane
        maxHeight="1.7976931348623157E308"
        maxWidth="1.7976931348623157E308"
        minHeight="-Infinity"
        minWidth="-Infinity"
        stylesheets="/css/style.css"
        styleClass="background"
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controller.ListarTarefasController">

    <children>

        <BorderPane
                maxHeight="1.7976931348623157E308"
                maxWidth="1.7976931348623157E308"
                AnchorPane.bottomAnchor="20.0"
                AnchorPane.leftAnchor="20.0"
                AnchorPane.rightAnchor="20.0"
                AnchorPane.topAnchor="20.0">

            <!-- ================================================= -->
            <!-- CABEÇALHO + FILTROS -->
            <!-- ================================================= -->

            <top>

                <VBox
                        spacing="35.0"
                        styleClass="header">

                    <children>

                        <!-- ========================= -->
                        <!-- CABEÇALHO -->
                        <!-- ========================= -->

                        <GridPane
                                hgap="10.0"
                                maxWidth="1.7976931348623157E308"
                                vgap="8.0">

                            <columnConstraints>

                                <ColumnConstraints
                                        hgrow="SOMETIMES"
                                        minWidth="0.0" />

                                <ColumnConstraints
                                        hgrow="NEVER"
                                        minWidth="0.0" />

                            </columnConstraints>

                            <rowConstraints>

                                <RowConstraints
                                        minHeight="50.0"
                                        prefHeight="50.0"
                                        vgrow="NEVER" />

                                <RowConstraints
                                        minHeight="1.0"
                                        prefHeight="1.0"
                                        vgrow="NEVER" />

                            </rowConstraints>

                            <children>

                                <!-- TÍTULO -->

                                <Label
                                        text="Tarefas"
                                        styleClass="titulo"
                                        GridPane.columnIndex="0"
                                        GridPane.rowIndex="0">

                                    <font>
                                        <Font
                                                name="Arial Bold"
                                                size="30.0" />
                                    </font>

                                </Label>


                                <!-- BOTÃO ADICIONAR -->

                                <Button
                                        minWidth="170.0"
                                        prefHeight="40.0"
                                        text="+ Adicionar Tarefa"
                                        styleClass="button-principal"
                                        onAction="#abrirAdicionarTarefa"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="0" />


                                <!-- SEPARADOR -->

                                <Separator
                                        maxWidth="1.7976931348623157E308"
                                        GridPane.columnIndex="0"
                                        GridPane.columnSpan="2"
                                        GridPane.rowIndex="1" />

                            </children>

                        </GridPane>


                        <!-- ========================= -->
                        <!-- FILTROS -->
                        <!-- ========================= -->

                        <GridPane
                                hgap="15.0"
                                maxWidth="1.7976931348623157E308"
                                vgap="10.0">

                            <columnConstraints>

                                <!-- PESQUISA -->

                                <ColumnConstraints
                                        hgrow="SOMETIMES"
                                        minWidth="0.0"
                                        percentWidth="30.0" />

                                <!-- CATEGORIA -->

                                <ColumnConstraints
                                        hgrow="SOMETIMES"
                                        minWidth="0.0"
                                        percentWidth="18.0" />

                                <!-- PRIORIDADE -->

                                <ColumnConstraints
                                        hgrow="SOMETIMES"
                                        minWidth="0.0"
                                        percentWidth="18.0" />

                                <!-- ESTADO -->

                                <ColumnConstraints
                                        hgrow="SOMETIMES"
                                        minWidth="0.0"
                                        percentWidth="18.0" />

                                <!-- LIMPAR -->

                                <ColumnConstraints
                                        hgrow="SOMETIMES"
                                        minWidth="0.0"
                                        percentWidth="16.0" />

                            </columnConstraints>

                            <rowConstraints>

                                <RowConstraints
                                        minHeight="40.0"
                                        prefHeight="40.0"
                                        vgrow="NEVER" />

                            </rowConstraints>

                            <children>

                                <!-- ========================= -->
                                <!-- PESQUISA -->
                                <!-- ========================= -->

                                <TextField
                                        fx:id="txtPesquisa"
                                        maxWidth="1.7976931348623157E308"
                                        prefHeight="40.0"
                                        promptText="Pesquisar tarefa..."
                                        styleClass="filtro-pesquisa"
                                        onAction="#filtrarTabela"
                                        GridPane.columnIndex="0" />


                                <!-- ========================= -->
                                <!-- CATEGORIA -->
                                <!-- ========================= -->

                                <ComboBox
                                        fx:id="cbFiltroCategoria"
                                        maxWidth="1.7976931348623157E308"
                                        prefHeight="40.0"
                                        styleClass="filtro"
                                        onAction="#filtrarTabela"
                                        GridPane.columnIndex="1" />


                                <!-- ========================= -->
                                <!-- PRIORIDADE -->
                                <!-- ========================= -->

                                <ComboBox
                                        fx:id="cbFiltroPrioridade"
                                        maxWidth="1.7976931348623157E308"
                                        prefHeight="40.0"
                                        styleClass="filtro"
                                        onAction="#filtrarTabela"
                                        GridPane.columnIndex="2" />


                                <!-- ========================= -->
                                <!-- ESTADO -->
                                <!-- ========================= -->

                                <ComboBox
                                        fx:id="cbFiltroEstado"
                                        maxWidth="1.7976931348623157E308"
                                        prefHeight="40.0"
                                        styleClass="filtro"
                                        onAction="#filtrarTabela"
                                        GridPane.columnIndex="3" />


                                <!-- ========================= -->
                                <!-- LIMPAR FILTROS -->
                                <!-- ========================= -->

                                <Button
                                        maxWidth="1.7976931348623157E308"
                                        prefHeight="40.0"
                                        text="Limpar filtros"
                                        styleClass="button-cancelar"
                                        onAction="#limparFiltros"
                                        GridPane.columnIndex="4" />

                            </children>

                        </GridPane>

                    </children>

                </VBox>

            </top>


            <!-- ================================================= -->
            <!-- TABELA + PAGINAÇÃO -->
            <!-- ================================================= -->

            <center>

                <VBox
                        maxHeight="1.7976931348623157E308"
                        maxWidth="1.7976931348623157E308"
                        spacing="12.0">

                    <children>

                        <!-- ========================= -->
                        <!-- TABELA -->
                        <!-- ========================= -->

                        <TableView
                                fx:id="tblTarefas"
                                maxHeight="460.0"
                                maxWidth="1.7976931348623157E308"
                                prefHeight="460.0"
                                styleClass="tabela-tarefas"
                                VBox.vgrow="ALWAYS">

                            <columns>

                                <TableColumn
                                        fx:id="colTitulo"
                                        prefWidth="220.0"
                                        sortable="false"
                                        text="Título" />

                                <TableColumn
                                        fx:id="colCategoria"
                                        prefWidth="150.0"
                                        sortable="false"
                                        text="Categoria" />

                                <TableColumn
                                        fx:id="colPrioridade"
                                        prefWidth="140.0"
                                        sortable="false"
                                        text="Prioridade" />

                                <TableColumn
                                        fx:id="colDataLimite"
                                        prefWidth="150.0"
                                        sortable="false"
                                        text="Data Limite" />

                                <TableColumn
                                        fx:id="colDataEntrega"
                                        prefWidth="150.0"
                                        sortable="false"
                                        text="Data Entrega" />

                                <TableColumn
                                        fx:id="colEstado"
                                        prefWidth="140.0"
                                        sortable="false"
                                        text="Estado" />

                                <TableColumn
                                        fx:id="colAcao"
                                        prefWidth="180.0"
                                        sortable="false"
                                        text="Ações" />

                            </columns>

                        </TableView>


                        <!-- ========================= -->
                        <!-- PAGINAÇÃO -->
                        <!-- ========================= -->

                        <Pagination
                                fx:id="paginacao"
                                maxHeight="40.0"
                                maxPageIndicatorCount="5"
                                prefHeight="50.0"
                                    styleClass="paginacao"
                                VBox.vgrow="NEVER" />

                    </children>

                    <BorderPane.margin>
                        <Insets top="20.0" />
                    </BorderPane.margin>

                </VBox>

            </center>

        </BorderPane>

    </children>

</AnchorPane>